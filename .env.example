# Local development only. Copy this file to .env and fill secrets locally.
# Do not commit .env.

PAPER_PRESETS=aggressive-eth-2h,active-eth-1h,aggressive-eth-30m,growth-eth-4h,balanced-btc-4h,stable-sol-4h
PAPER_INITIAL_CASH=1000
PAPER_SLEEP_SECONDS=60
PORT=10000

SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_DB_HOST=your_pooler_or_database_host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace_me
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
